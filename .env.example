# Application Settings
APP_NAME=Model Inference API
VERSION=1.0.0
DEBUG=False

# API Configuration
API_V1_PREFIX=/api/v1
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".mp4", ".avi", ".mov"]
CORS_ALLOWED_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=False

# Database
DATABASE_URL=sqlite:///./app.db

# Model Configuration
MODEL_WEIGHTS_DIR=./model_weights
MODEL_WEIGHTS_LIST_FILE=./model_weights.json
GCS_SERVICE_ACCOUNT_FILE=./service-account.json
GCS_BUCKET_NAME=your-gcs-bucket-name

# Upload Directory
UPLOAD_DIR=./uploads

# Queue Settings
MAX_QUEUE_SIZE=1000
WORKER_COUNT=2
# Keep empty to use in-process model path.
# Set this only when you trust and control the command runtime.
INFERENCE_COMMAND=
INFERENCE_TEMP_DIR=./tmp_inference
INFERENCE_RESULT_FILE=result.json
